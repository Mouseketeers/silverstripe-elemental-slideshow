{
    "name": "mouseketeers/silverstripe-elemental-slideshow",
    "description": "Elemental slideshow",
    "authors": [
        {
            "name": "Mouseketeers",
            "email": "support@mouseketeers.dk",
            "homepage": "http://www.mouseketeers.dk"
        }
    ],
    "keywords": [
        "silverstripe",
        "elemental",
        "content",
        "blocks",
        "content"
    ],
    "type": "silverstripe-vendormodule",
    "license": "BSD-3-Clause",
    "require": {
        "dnadesign/silverstripe-elemental": "^6",
        "silverstripe/linkfield": "^5",
        "php": "^8.3",
        "silverstripe/framework": "^6"
    },
    "config": {
        "process-timeout": 600
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Mouseketeers\\Elements\\Slideshow\\": "src/"
        }
    },
    "extra": {
        "expose": [
            "client/dist"
        ]
    }
}
